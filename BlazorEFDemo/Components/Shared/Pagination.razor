@if (TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination mb-0">
 
            <!-- First page button -->
            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                <button class="page-link"
                        @onclick="() => PageChanged(1)"
                        title="First page">
                    «
                </button>
            </li>
 
            <!-- Previous button -->
            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                <button class="page-link"
                        @onclick="() => PageChanged(CurrentPage - 1)">
                    ‹
                </button>
            </li>
 
            <!-- Smart page number window -->
            @foreach (var pagepag in GetPageNumbers())
            {
                @if (pagepag == -1)
                {
                    <!-- Ellipsis slot -->
                    <li class="page-item disabled">
                        <span class="page-link">…</span>
                    </li>
                }
                else
                {
                    <li class="page-item
                            @(CurrentPage == pagepag ? "active" : "")">
                        <button class="page-link"
                                @onclick="() => PageChanged(pagepag)">
                            @pagepag
                        </button>
                    </li>
                }
            }
 
            <!-- Next button -->
            <li class="page-item
                    @(CurrentPage == TotalPages ? "disabled" : "")">
                <button class="page-link"
                        @onclick="() => PageChanged(CurrentPage + 1)">
                    ›
                </button>
            </li>
 
            <!-- Last page button -->
            <li class="page-item
                    @(CurrentPage == TotalPages ? "disabled" : "")">
                <button class="page-link"
                        @onclick="() => PageChanged(TotalPages)"
                        title="Last page">
                    »
                </button>
            </li>
 
        </ul>
    </nav>
}
 
@code {
    [Parameter] public int CurrentPage  { get; set; }
    [Parameter] public int TotalPages   { get; set; }
    [Parameter] public EventCallback<int> OnPageChange { get; set; }
 
    private async Task PageChanged(int page)
    {
        // Guard: only fire if page is valid AND different from current
        if (page >= 1 && page <= TotalPages && page != CurrentPage)
            await OnPageChange.InvokeAsync(page);
    }
 
    // Returns page numbers, using -1 as the ellipsis placeholder
    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
 
        // 7 or fewer pages — show all, no ellipsis needed
        if (TotalPages <= 7)
        {
            for (int i = 1; i <= TotalPages; i++) pages.Add(i);
            return pages;
        }
 
        // Always include page 1
        pages.Add(1);
 
        // Left ellipsis if current page is far from start
        if (CurrentPage > 4) pages.Add(-1);
 
        // Window of 5 around the current page
        int start = Math.Max(2, CurrentPage - 2);
        int end   = Math.Min(TotalPages - 1, CurrentPage + 2);
        for (int i = start; i <= end; i++) pages.Add(i);
 
        // Right ellipsis if current page is far from end
        if (CurrentPage < TotalPages - 3) pages.Add(-1);
 
        // Always include last page
        pages.Add(TotalPages);
 
        return pages;
    }
}