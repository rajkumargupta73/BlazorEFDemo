@page "/categories/edit/{Id:int}"
@using BlazorEFDemo.Interfaces
@using BlazorEFDemo.DTOs
@rendermode InteractiveServer
@inject ICategoryService CategoryService
@inject NavigationManager Nav

<div class="container mt-4" style="max-width:600px">
    <h3 class="mb-4">Edit Category</h3>
    @if (model == null)
    {
        <div class="text-center py-4">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger" />
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger">@error</div>
            }
            <div class="mb-3">
                <label class="form-label fw-bold">
                    Name <span class="text-danger">*</span>
                </label>
                <InputText class="form-control" @bind-Value="model.Name" />
                <ValidationMessage For="() => model.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Description</label>
                <InputTextArea class="form-control" rows="3"
                               @bind-Value="model.Description" />
                <ValidationMessage For="() => model.Description" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success" disabled="@busy">
                    @(busy ? "Saving..." : "Save Changes")
                </button>
                <a href="/categories" class="btn btn-secondary">Cancel</a>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    // ✅ Plain class — not a record
    private UpdateCategoryDto? model;
    private string? error;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        var dto = await CategoryService.GetByIdAsync(Id);
        if (dto == null) { Nav.NavigateTo("/categories"); return; }

        // ✅ Object initializer — NOT record constructor syntax
        model = new UpdateCategoryDto
            {
                Id = dto.Id,
                Name = dto.Name,
                Description = dto.Description
            };
    }

    private async Task Submit()
    {
        busy = true; error = null;
        var result = await CategoryService.UpdateAsync(model!);
        if (result.Success) Nav.NavigateTo("/categories");
        else { error = result.Message; busy = false; }
    }
}
